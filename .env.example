# Sideword Server — sample configuration.
# Copy to `.env` and adjust before running.

# Secret for signing client JWTs and admin sessions.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SIDEWORD_SECRET_KEY=replace-this-with-output-from-the-command-above

# Client JWT lifetime in hours. Default ~30 days.
SIDEWORD_JWT_TTL_HOURS=720

# Public server URL (used when building invite links in the admin UI).
# Example: https://sideword.example.com
SIDEWORD_PUBLIC_URL=http://localhost:8000

# Bootstrap admin account. Created automatically on first startup if missing.
# You may remove these from .env after the admin exists in the database.
SIDEWORD_ADMIN_USERNAME=admin
SIDEWORD_ADMIN_PASSWORD=change-me-too

# How many days to retain undelivered ciphertext before TTL purge.
SIDEWORD_MESSAGE_TTL_DAYS=30

# Max ciphertext length per message (bytes).
SIDEWORD_MAX_CIPHERTEXT_BYTES=65536

# Additive security rollout. Keep legacy support until clients have migrated.
SIDEWORD_ALLOW_LEGACY_ACK=true
# Optional fixed UTC sunset for JWTs without a registered session ID:
# SIDEWORD_LEGACY_TOKEN_DEADLINE=2027-01-01T00:00:00Z
SIDEWORD_CLIENT_ACCESS_MINUTES=15
SIDEWORD_CLIENT_SESSION_DAYS=30
SIDEWORD_REFRESH_RETRY_SECONDS=30
SIDEWORD_SEND_IDEMPOTENCY_DAYS=30

# Transport and abuse limits. Never trust arbitrary forwarded addresses.
SIDEWORD_REQUIRE_HTTPS=true
SIDEWORD_PRIVATE_ADMIN=true
SIDEWORD_TRUSTED_PROXY_IPS=127.0.0.1
# Standalone Uvicorn/Docker reads FORWARDED_ALLOW_IPS from its process environment.
FORWARDED_ALLOW_IPS=127.0.0.1
SIDEWORD_MAX_REQUEST_BYTES=2097152
SIDEWORD_REQUESTS_PER_MINUTE=600
SIDEWORD_LOGIN_ATTEMPTS_PER_MINUTE=10
SIDEWORD_MAX_PENDING_MESSAGES=10000
SIDEWORD_MAX_PENDING_BYTES=268435456
SIDEWORD_MAX_READ_RECEIPTS=10000
SIDEWORD_MAX_SEND_RECORDS=100000
SIDEWORD_MAX_USERS=10000
SIDEWORD_MAX_WS_CONNECTIONS=256
SIDEWORD_MAX_WS_PER_USER=4
# Presence requires one shared process; disable across independent workers/replicas.
SIDEWORD_PRESENCE_ENABLED=true
SIDEWORD_MAX_PENDING_PER_SENDER=1000
SIDEWORD_MAX_PENDING_BYTES_PER_SENDER=16777216
SIDEWORD_SENDS_PER_MINUTE=60
